vie () {
  local dir f
  dir="$(find . -maxdepth 3 -type d 2>/dev/null | sed 's|^\./||' | grep -v '^\.$' | fzf --prompt 'dir> ')" || return
  f="$(find "./$dir" -maxdepth 3 -type f 2>/dev/null | sed "s|^\./$dir/||" | fzf --prompt 'nvim> ')" || return
  nvim "./$dir/$f"
}

vir () {
  local f
  f="$(find . -type f -printf '%P\n' 2>/dev/null | fzf --prompt 'nvim> ')" || return
  nvim "./$f"
}

vif () {
  local f
  f="$(find . -maxdepth 1 -type f -printf '%P\n' 2>/dev/null | fzf --prompt 'nvim> ')" || return
  nvim "./$f"
}

vifind () {  # nvfind <filename or glob>
  local pat="${1:?usage: nvfind <name>}"
  local matches
  mapfile -t matches < <(find . -type f -name "$pat" -print 2>/dev/null | sed 's|^\./||')
  if (( ${#matches[@]} == 0 )); then
    echo "No match for: $pat" >&2
    return 1
  elif (( ${#matches[@]} == 1 )); then
    nvim "${matches[0]}"
  else
    printf '%s\n' "${matches[@]}" | fzf --prompt 'open> ' | xargs -r nvim
  fi
}

fscancel() {
  # Usage: fscancel [scancel_args...]
  # Examples:
  #   fscancel              (cancel selected jobs)
  #   fscancel --signal=KILL (send signal)
  command -v squeue >/dev/null 2>&1 || { echo "squeue not found"; return 1; }
  command -v scancel >/dev/null 2>&1 || { echo "scancel not found"; return 1; }

  local extra_args=("$@")
  local selected jobids

  selected=$(
    squeue -u "$USER" -o "%.18i %.9P %.25j %.8T %.10M %.6D %R" -h \
    | fzf -m --prompt="scancel> " \
          --header="TAB=multi-select  ENTER=scancel  CTRL-R=reload" \
          --preview='jid=$(echo {} | awk "{print \$1}"); scontrol show job "$jid" | sed -n "1,120p"' \
          --bind="ctrl-r:reload(squeue -u $USER -o '%.18i %.9P %.25j %.8T %.10M %.6D %R' -h)" \
  ) || return

  jobids=$(echo "$selected" | awk '{print $1}' | tr '\n' ' ')
  [[ -n "${jobids// /}" ]] || return

  echo "About to run: scancel ${extra_args[*]} $jobids"
  read -r -p "Proceed? [y/N] " ans
  [[ "$ans" == "y" || "$ans" == "Y" ]] || { echo "Canceled."; return; }

  scancel "${extra_args[@]}" $jobids
}


# Pick job(s) via fzf and print jobid(s), one per line
sjid_pick() {
  command -v squeue >/dev/null 2>&1 || { echo "squeue not found"; return 1; }

  local selected
  selected=$(
    squeue -u "$USER" -o "%.18i %.9P %.25j %.8T %.10M %.6D %R" -h \
    | fzf -m --prompt="jobid> " \
          --header="TAB=multi-select  ENTER=output jobid(s)  CTRL-R=reload" \
          --preview='jid=$(echo {} | awk "{print \$1}"); scontrol show job "$jid" 2>/dev/null | sed -n "1,120p"' \
          --bind="ctrl-r:reload(squeue -u $USER -o '%.18i %.9P %.25j %.8T %.10M %.6D %R' -h)"
  ) || return

  echo "$selected" | awk '{print $1}'
}

# Pick job(s) then copy IDs to tmux buffer (and also echo them)
sjid() {
  local ids text
  ids=$(sjid_pick) || return
  text=$(echo "$ids" | paste -sd' ' -)
  [[ -n "$text" ]] || return

  if [[ -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
    printf "%s" "$text" | tmux load-buffer -
    tmux display-message "Copied jobid(s): $text"
  fi

  echo "$text"
}

