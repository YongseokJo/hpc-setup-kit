# Keep full-screen apps from leaving the terminal cursor steady at the prompt.
__hpc_blinking_block_cursor() {
  printf '\e[1 q'
}
case ";${PROMPT_COMMAND:-};" in
  *";__hpc_blinking_block_cursor;"*) ;;
  *) PROMPT_COMMAND="__hpc_blinking_block_cursor${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;;
esac

