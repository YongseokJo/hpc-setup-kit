# ~/.zshrc — interactive Zsh setup for the same environment as config/bashrc.

export PATH="$HOME/.local/bin:$HOME/bin:$HOME/opt/nvim/bin:$PATH"

autoload -Uz compinit
# Reuse the completion dump when possible; a full security scan on every shell
# is noticeably expensive on network-mounted cluster homes.
compinit -C

setopt COMPLETE_IN_WORD NO_BEEP
bindkey -v
bindkey -M viins 'kj' vi-cmd-mode

# Cluster navigation and common commands.
alias down_popeye="scp yjo10@popeye:~/ceph/transfer/* ~/ceph/transfer"
alias up_popeye="scp ~/ceph/transfer/* yjo10@popeye:~/ceph/transfer "
alias popeye="ssh popeye"
alias qs="squeue -u $USER"
alias ll="ls -alrth"
alias psal="ps --user=$USER -ux"
alias rr="ssh dt-login02"
alias cd_p1="cd /projects/benb/$USER"
alias cd_p2="cd /projects/bfpt/$USER"
alias cd_w1="cd /work/nvme/benb/$USER"
alias cd_w2="cd /work/nvme/bfpt/$USER"
alias cd_w3="cd /work/hdd/benb/$USER"
alias cd_w4="cd /work/hdd/bfpt/$USER"
alias sb="sbatch"
alias sj="./submit_job.sh"
alias tm="$HOME/pyenv/torch/bin/turm -u '$USER'"
alias tt="tmux attach -t 0"
alias reload_shell="source ~/.zshrc"
alias gpu_check="~carriero/bin/gpuUsage -t 4 -u $USER"
alias vi="nvim"
alias nv="nvim"
alias cld='claude --dangerously-skip-permissions'

# Python environments.
alias venv="source ~/pyenv/venv/bin/activate"
alias newvenv="source ~/pyenv/newvenv/bin/activate"
alias torch="source ~/pyenv/torch/bin/activate"
alias nlp="source ~/pyenv/nlp/bin/activate"
alias sbi="source ~/pyenv/sbi/bin/activate"
alias yt_plot="source ~/pyenv/yt_plot/bin/activate"
alias venv_sbi="source ~/pyenv/venv_sbi/bin/activate"
alias lightning="source ~/pyenv/lightning/bin/activate"
alias mine="source ~/pyenv/mine/bin/activate"
alias MI="source ~/pyenv/MI/bin/activate"

alias int_gpu="srun --nodes=1 --ntasks-per-node=1 --cpus-per-task=6 --partition=gpuA40x4 --gpus-per-node=1 --account=bfpt-delta-gpu --time=48:00:00 --constraint=scratch --job-name=interact --pty /bin/bash"
alias int_cpu="srun --nodes=1 --ntasks-per-node=1 --cpus-per-task=4 --partition=cpu --account=bgak-delta-cpu --time=48:00:00 --job-name=interact-cpu --pty /bin/bash"

# Remember the last Slurm submission script used in each directory.
sr() {
  local last_file_path=.last_run_code last_file
  if (( $# == 1 )); then
    print -r -- "$1" >| "$last_file_path"
    sbatch "$1"
  elif [[ -f "$last_file_path" ]]; then
    last_file=$(<"$last_file_path")
    if [[ -f "$last_file" ]]; then
      sbatch "$last_file"
      print -r -- "$last_file"
    else
      print -u2 -- "Previously saved file does not exist: $last_file"
      return 1
    fi
  else
    print -u2 -- "Usage: sr <filename> (or sr to repeat the saved script)"
    return 2
  fi
}

if [[ -x "$HOME/pyenv/torch/bin/turm" ]]; then
  eval "$("$HOME/pyenv/torch/bin/turm" completion zsh 2>/dev/null)"
fi

export NVM_DIR="$HOME/.nvm"
for node_bin in "$NVM_DIR"/versions/node/*/bin(N); do
  path=("$node_bin" $path)
done

# Keep Node available immediately, but defer the expensive nvm initialization
# until a version-management command is actually requested.
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  nvm() {
    unfunction nvm
    source "$NVM_DIR/nvm.sh"
    nvm "$@"
  }
fi

command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
  eval "$(zoxide init zsh --cmd cd)"
fi
