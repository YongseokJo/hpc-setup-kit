# ============================================================
# Claude warm theme for Ghostty  —  copy to your LOCAL machine
#
#   Linux:   ~/.config/ghostty/config
#   macOS:   ~/Library/Application Support/com.mitchellh.ghostty/config
#
# This is what your tmux + starship + vim/nvim are tuned against:
# cream background (#faf9f5), warm ink text, clay/coral accents.
# Reload Ghostty after editing (Cmd/Ctrl+Shift+,  or restart).
# ============================================================

# --- Light (default) ---------------------------------------
background = #faf9f5
foreground = #3d3d3a

cursor-color        = #c15f3c
cursor-text         = #faf9f5
selection-background = #e7d6cc
selection-foreground = #3d3d3a

# 16-color ANSI palette, warm-tuned so CLI tools match the editors.
palette = 0=#3d3d3a
palette = 1=#b83d2e
palette = 2=#5f7a2e
palette = 3=#a87b1f
palette = 4=#2f6cc1
palette = 5=#8b4789
palette = 6=#2e8b8b
palette = 7=#8a8a85
palette = 8=#aaaaa0
palette = 9=#c15f3c
palette = 10=#6f8f3a
palette = 11=#c2922b
palette = 12=#3f7fd0
palette = 13=#a85fa0
palette = 14=#3f9a9a
palette = 15=#3d3d3a

# ============================================================
# Dark variant — if you prefer Claude's dark mode, comment out
# the block above and uncomment this one. Then flip the editors:
#   nvim:  vim.opt.background = "dark"   (in init.lua)
#   vim:   set background=dark           (in vimrc, ~/.vimrc)
# ============================================================
# background = #262624
# foreground = #e8e6dc
# cursor-color        = #d97757
# cursor-text         = #262624
# selection-background = #45433f
# selection-foreground = #e8e6dc
# palette = 0=#262624
# palette = 1=#e8806a
# palette = 2=#a3b86a
# palette = 3=#d9a85f
# palette = 4=#8aadf4
# palette = 5=#c98aa0
# palette = 6=#7fc0bd
# palette = 7=#b5b3aa
# palette = 8=#62625c
# palette = 9=#d97757
# palette = 10=#b3c87a
# palette = 11=#e0b870
# palette = 12=#9ab8ff
# palette = 13=#d2a0b0
# palette = 14=#8fd0cd
# palette = 15=#e8e6dc
